# Polymation Studio — example environment file.
#
# M0.1 requires NO credentials, API keys or paid services. The platform runs
# entirely offline against the local filesystem and a local FFmpeg install.
#
# Copy to `.env` only if you need to override the defaults below. `.env` is
# git-ignored. Never commit real credentials to this repository.

# Absolute path to the Polymation Studio workspace root. When unset, the CLI
# walks up from the current directory looking for a `channels/` directory and
# falls back to the current working directory.
# POLYMATION_HOME=/absolute/path/to/polymation-studio

# Explicit paths to the FFmpeg binaries, if they are not on PATH.
# POLYMATION_FFMPEG=/usr/bin/ffmpeg
# POLYMATION_FFPROBE=/usr/bin/ffprobe

# Identifier recorded as the approver on human approval records.
# POLYMATION_APPROVER=your-name
